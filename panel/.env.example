# Copy to .env and fill in. The panel connects to the SAME MySQL database the
# CS2 plugin uses (e.g. your DatHost database).

# MySQL (DatHost "Databases" panel)
DB_HOST=twoj-host.dathost.net
DB_PORT=3306
DB_USER=uzytkownik
DB_PASSWORD=haslo
DB_NAME=nazwa_bazy
DB_PREFIX=retakes_

# Which game server this panel controls (must match RemoteControlSettings.ServerId)
SERVER_ID=cwelownia1

# Web panel
PORT=8080
# Login for the panel (change these!)
ADMIN_USER=admin
ADMIN_PASSWORD=zmien-to-haslo
# Random long string for signing sessions
SESSION_SECRET=zmien-na-losowy-ciag-znakow
